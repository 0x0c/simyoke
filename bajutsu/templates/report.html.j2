{#- Self-contained interactive HTML report. report.py builds a pure-data context;
    all markup lives here. CSS/JS are inlined (passed in as `css` / `js`). -#}
{%- macro parts(items) -%}
{%- for kind, text in items -%}
{%- if kind %}<span class="tk {{ kind }}">{{ text }}</span>{% else %}{{ text }}{% endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro actbadge(a) -%}
{%- if a %}<span class="act{% if a.cls %} {{ a.cls }}{% endif %}">{{ a.label }}</span>{% endif -%}
{%- endmacro -%}

{%- macro nxvalue(v) -%}
{%- if v.kind == 'parts' %}{{ parts(v.parts) }}
{%- elif v.kind == 'headers' %}{% for k, hv in v.pairs %}{% if not loop.first %}<br>{% endif %}<span class="nxhk">{{ k }}</span>: {{ hv }}{% endfor %}
{%- elif v.kind == 'body' %}<pre class="nxpre">{{ v.text }}</pre>{% endif -%}
{%- endmacro -%}

{%- macro detail(d) -%}
{%- if d.kind == 'parts' -%}{{ parts(d.parts) }}
{%- elif d.kind == 'asserts' -%}<table class="atbl"><tbody>{% for kind, target, comp in d.rows %}<tr><td><span class="act act-kind">{{ kind }}</span></td><td class="adesc">{{ parts(target) }}</td><td class="adesc">{{ parts(comp) }}</td></tr>{% endfor %}</tbody></table>
{%- elif d.kind == 'nxsummary' -%}<span class="xmark">▸</span> {{ parts(d.summary) }}
{%- endif -%}
{%- if d.name %} <span class="stepname">{{ d.name }}</span>{% endif %}{% for c in d.caps %} <span class="cap">{{ c }}</span>{% endfor %}{% if d.from_ %}<div class="stepfrom" title="the natural-language phrase this was recorded from">← {{ d.from_ }}</div>{% endif %}
{%- endmacro -%}

{%- macro treetable(rows, sw, sh) -%}
<table class="tvtbl"{% if sw and sh %} data-sw="{{ sw }}" data-sh="{{ sh }}"{% endif %}><thead><tr><th>id</th><th>label</th><th>value</th><th>traits</th><th>frame</th></tr></thead><tbody>{% for e in rows %}<tr{% if e.rect %} class="tvrow" data-x="{{ e.rect.x }}" data-y="{{ e.rect.y }}" data-w="{{ e.rect.w }}" data-h="{{ e.rect.h }}"{% endif %}><td class="tvid">{{ e.id }}</td><td>{{ e.label }}</td><td>{{ e.value }}</td><td class="tvtr">{{ e.traits }}</td><td class="tvfr">{{ e.frame }}</td></tr>{% endfor %}</tbody></table>
{%- endmacro -%}

{%- macro stepview(v) -%}
{%- if v is none %}—{% else %}{% if v.shot %}<img class="shot" loading="lazy" src="{{ v.shot }}" alt="{{ v.alt }}">{% endif %}{% if v.tree_rows is not none %}<button class="elnk treebtn" type="button" data-count="{{ v.tree_count }}"{% if v.unpaired %} title="the screenshot and the element tree describe different screens, so element frames are not drawn on this step"{% endif %}>tree</button><template class="treedata">{{ treetable(v.tree_rows, v.screen_w, v.screen_h) }}</template>{% elif v.tree %}<a class="elnk" href="{{ v.tree }}" target="_blank" rel="noopener">tree</a>{% endif %}{% if not v.shot and not v.tree %}—{% endif %}{% endif -%}
{%- endmacro -%}

{%- macro actuation(a) -%}
<span class="actn{% if a.refused %} actn-no{% endif %}"><span class="actn-g">{{ a.gesture }}</span>{% if a.points %} <span class="actn-p">{{ a.points }}</span>{% elif a.frame %} <span class="actn-f">{{ a.frame }}</span>{% endif %}{% if a.unit %} <span class="actn-u">{{ a.unit }}</span>{% endif %}{% if a.target %} on <span class="tk id">{{ a.target }}</span>{% endif %}{% if a.params %} <span class="actn-x">{{ a.params }}</span>{% endif %} <span class="actn-v">via {{ a.via }}</span>{% if a.substitution %} <span class="actn-s" title="the driver actuated a different element than the selector named, for this reason">{{ a.substitution }}</span>{% endif %}{% if a.refused %} <span class="actn-r">refused</span>{% endif %}</span>
{%- endmacro -%}
{%- macro alertline(a, suffix='') -%}
{% if a.kind == 'notificationBanner' %}<span class="act act-alert">notification banner</span> swiped away{% else %}<span class="act act-alert">system alert</span> dismissed{% endif %}{{ suffix }}{% if a.label %} <span class="tk str">“{{ a.label }}”</span>{% endif %}
{%- endmacro -%}
{%- macro steprow(row, phase=none) -%}
<tr class='{{ row.rowcls }}'{% if row.data_t %} data-t='{{ row.data_t }}'{% endif %}{% if row.data_t_end %} data-t-end='{{ row.data_t_end }}'{% endif %}{% if phase %} data-phase='{{ phase }}'{% endif %}{% if row.title %} title='{{ row.title }}'{% endif %} role="row"><td role="cell"{% if row.numcls %} class='{{ row.numcls }}'{% endif %}>{{ row.num }}{% if row.line %}<span class="linehint" title="scenario file line {{ row.line }}">:{{ row.line }}</span>{% endif %}</td><td role="cell">{% if row.result is not none %}<span class="exst{% if row.result.cls %} {{ row.result.cls }}{% endif %}">{{ row.result.text }}</span>{% endif %}</td><td role="cell">{{ actbadge(row.action) }}</td><td role="cell" class='adesc'>{{ detail(row.detail) }}</td><td role="cell" class='atcell'>{% if row.data_t %}<button class="stepjump" type="button" data-t="{{ row.data_t }}" title="jump to the moment just before this step acted">{{ row.at }}</button>{% if row.at_end %}<button class="stepjump stepjump-end" type="button" data-t="{{ row.data_t_end }}" title="jump to the moment just after this step acted">→{{ row.at_end }}</button>{% endif %}{% if row.elapsed %} <span class="stepdur">({{ row.elapsed }})</span>{% endif %}{% else %}{{ row.at }}{% endif %}</td><td role="cell" class='ev'>{{ stepview(row.view) }}</td><td role="cell">{% if row.reason %}<span class="exreason">{{ row.reason }}</span>{% endif %}</td></tr>{% if row.alerts %}<tr class='alertrow' title='something system-owned was covering the app while this step ran — what cleared it, and how'><td colspan='7'>{% for a in row.alerts %}{{ alertline(a) }}{% endfor %}</td></tr>{% endif %}{% if row.actuations or row.dropped_actuations %}<tr class='actrow' title='what the driver actually did to the screen — the coordinate it sent (or the frame the platform resolved from) and the channel that carried the gesture'><td colspan='7'>{% for a in row.actuations %}{{ actuation(a) }}{% endfor %}{% if row.dropped_actuations %}<span class="actn actn-drop">+{{ row.dropped_actuations }} actuation(s) missing from this record</span>{% endif %}</td></tr>{% endif %}{% if row.generated %}<tr class='genrow' title='the value this generate step produced for ${vars.*} — recorded so a later failure shows which value the run actually used'><td colspan='7'><span class="act">generated</span> <span class="tk str">“{{ row.generated }}”</span></td></tr>{% endif %}{% if row.expand %}<tr class='nxdetail' hidden><td colspan='7'><table class="nxtbl"><tbody>{% for label, val in row.expand.pairs %}<tr><td class="nxk">{{ label }}</td><td class="nxv">{{ nxvalue(val) }}</td></tr>{% endfor %}</tbody></table></td></tr>{% endif %}
{%- endmacro -%}

{%- macro vshot(label, src, cls) -%}
{%- if src %}<figure class="vshot {{ cls }}"><figcaption>{{ label }}</figcaption><a href="{{ src }}" target="_blank" rel="noopener"><img loading="lazy" src="{{ src }}" alt="{{ label }}"></a></figure>{% endif -%}
{%- endmacro -%}

{%- macro vcompare(v) -%}
<div class="vcmp mode-swipe" style="--p:50%"><div class="vcmp-ctl"><div class="vcmp-modes"><button type="button" class="vcmp-mode active" data-mode="swipe">Swipe</button><button type="button" class="vcmp-mode" data-mode="onion">Onion</button><button type="button" class="vcmp-mode" data-mode="blend">Blend</button>{% if v.diff %}<button type="button" class="vcmp-mode" data-mode="diff" title="machine pixel diff (exclude regions masked)">Diff</button>{% endif %}</div><input class="vcmp-range" type="range" min="0" max="100" value="50" aria-label="compare position"></div><div class="vcmp-stage"><img class="vcmp-base" loading="lazy" src="{{ v.baseline }}" alt="baseline"><img class="vcmp-over" loading="lazy" src="{{ v.actual }}" alt="actual">{% if v.diff %}<img class="vcmp-diff" loading="lazy" src="{{ v.diff }}" alt="diff">{% endif %}<span class="vcmp-handle" aria-hidden="true"></span></div><div class="vcmp-legend"><a href="{{ v.baseline }}" target="_blank" rel="noopener">baseline</a> · <a href="{{ v.actual }}" target="_blank" rel="noopener">actual</a>{% if v.diff %} · <a href="{{ v.diff }}" target="_blank" rel="noopener">diff</a>{% endif %}</div></div>
{%- endmacro -%}

{%- macro visual_strip(v) -%}
<tr class='visrow'><td colspan='4'>{% if v.baseline and v.actual %}{{ vcompare(v) }}{% elif v.actual %}<div class="vstrip">{{ vshot('actual', v.actual, 'va') }}</div>{% else %}<div class="vstrip"><span class="muted">no images captured</span></div>{% endif %}<div class="vmeta">{% if v.missing %}<span class="vbadge miss">no baseline yet</span>{% elif v.diff_pct %}<span class="vbadge">diff {{ v.diff_pct }}</span>{% endif %}{% if v.element_scoped %}<span class="vbadge" title="the comparison was cropped to one element's frame">element-scoped</span>{% endif %}{% if v.masked_selectors %}<span class="vbadge" title="masked by selector: {{ v.masked_selectors|join(', ') }}">{{ v.masked_selectors|length }} masked</span>{% endif %}{% if v.approvable %}<button class="vapprove" type="button" data-sid="{{ v.sid }}" data-baseline="{{ v.baseline_name }}">Approve as baseline</button>{% endif %}</div></td></tr>
{%- endmacro -%}

{%- macro exrow(row) -%}
<tr class='{{ row.rowcls }}'><td><span class="exst{% if row.stcls %} {{ row.stcls }}{% endif %}">{{ row.status }}</span></td><td><span class="act act-kind">{{ row.kind }}</span></td><td class="adesc">{{ parts(row.target) }}</td><td class="adesc">{{ parts(row.comp) }}</td></tr>{% if row.reason %}<tr class='exreasonrow'><td colspan='4'><span class="exreason">{{ row.reason }}</span></td></tr>{% endif %}{% if row.visual %}{{ visual_strip(row.visual) }}{% endif %}
{%- endmacro -%}

{%- macro precond(rows) -%}
{%- if rows %}<details class="pre" open><summary>preconditions ({{ rows|length }})</summary><table class="pretbl"><tbody>{% for k, v in rows %}<tr><td class="pk">{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}</tbody></table></details>{% endif -%}
{%- endmacro -%}

{#- one lifecycle phase's step table (BE-0392): same columns as the scenario's own steps, its own
    label, so setup and teardown read as distinct phases rather than more numbered steps -#}
{%- macro steptable(label, rows, phase) -%}
<div class="steps-sec"><span class="deflbl">{{ label }}</span><table class='sttbl' role="table"><tbody role="rowgroup">{% for row in rows %}{{ steprow(row, phase) }}{% endfor %}</tbody></table></div>
{%- endmacro -%}

{%- macro rich(p) -%}
<div class="rich-wrap"><div class="rich-scroll">{{ precond(p.preconditions) }}{% if p.beforerows %}{{ steptable('before', p.beforerows, 'before') }}{% endif %}<div class="steps-sec"><span class="deflbl">steps</span><table class='sttbl' role="table"><tbody role="rowgroup">{% for row in p.steprows %}{{ steprow(row) }}{% endfor %}</tbody></table></div>{% if p.afterrows %}{{ steptable('after', p.afterrows, 'after') }}{% endif %}</div>{% if p.expects %}<div class="expects"><span class="deflbl">{{ p.expects.label }}</span><table class='extbl'><thead><tr><th>result</th><th>kind</th><th>target</th><th>comparison</th></tr></thead><tbody>{% for row in p.expects.rows %}{{ exrow(row) }}{% endfor %}</tbody></table>{% if p.expects.alerts %}<div class="alertnote">{% for a in p.expects.alerts %}{{ alertline(a, ' before re-checking') }}{% endfor %}</div>{% endif %}{% if p.expects.actuations or p.expects.dropped_expect_actuations %}<div class="actnote">{% for a in p.expects.actuations %}{{ actuation(a) }}{% endfor %}{% if p.expects.dropped_expect_actuations %}<span class="actn actn-drop">+{{ p.expects.dropped_expect_actuations }} actuation(s) missing from this record</span>{% endif %}</div>{% endif %}</div>{% endif %}</div>
{%- endmacro -%}

{%- macro result_panel(p) -%}
{%- if p.source is not none -%}
<div class="vtoggle"><button class="vt active" data-view="rich">Rich</button><button class="vt" data-view="yaml">YAML</button></div><div class="view view-rich active">{{ rich(p) }}</div><div class="view view-yaml"><pre class="src">{{ p.source }}</pre></div>
{%- else -%}
{{ rich(p) }}
{%- endif -%}
{%- endmacro -%}

{%- macro nxitem(it) -%}
<details class="nx"><summary><span class="nxat muted" title="request time (offset from scenario start)">{{ it.at }}</span><span class="nxm">{{ it.method }}</span><span class="nxp">{{ it.target }}</span><span class="nxs{% if it.status_cls %} {{ it.status_cls }}{% endif %}">{{ it.status }}</span><span class="nxd muted">{{ it.dur }}</span>{% if it.mocked %}<span class="nxmock" title="served by a bajutsu mock stub (no real network call)">mock</span>{% endif %}</summary><div class="nxbody">
{%- if it.sections -%}
{%- for s in it.sections -%}
{%- if s.kind == 'line' %}<div class="nxsec"><span class="nxlbl">{{ s.label }}</span><div class="nxh{% if s.cls %} {{ s.cls }}{% endif %}">{{ s.text }}</div></div>
{%- elif s.kind == 'kv' %}<div class="nxsec"><span class="nxlbl">{{ s.label }}</span>{% for k, v in s.pairs %}<div class="nxh"><span class="nxhk">{{ k }}</span><span class="nxhv">{{ v }}</span></div>{% endfor %}</div>
{%- elif s.kind == 'pre' %}<div class="nxsec"><span class="nxlbl">{{ s.label }}</span><pre class="nxpre">{{ s.text }}</pre></div>{% endif -%}
{%- endfor -%}
{%- else %}<div class="muted">(no headers or body)</div>{% endif -%}
</div></details>
{%- endmacro -%}

{%- macro network_panel(p) -%}
{%- if p.empty %}<div class="muted">network: <a href="{{ p.link }}">{{ p.link }}</a> (no exchanges)</div>
{%- else %}<div class="muted">{{ p.count }} {{ p.plural }} captured by BajutsuKit · <a href="{{ p.link }}">{{ p.link }}</a></div><div class="nxlist">{% for it in p.exchanges %}{{ nxitem(it) }}{% endfor %}</div>{% endif -%}
{%- endmacro -%}

{%- macro log_panel(p) -%}
{%- if p.lines is none %}<div class="muted">device log: <a href="{{ p.link }}">{{ p.link }}</a></div>
{%- else %}<div class="logbar"><input class="logfilter" type="search" placeholder="filter log…"><span class="logcount muted">{{ p.shown }} lines</span></div><div class="muted">{{ p.note }}<a href="{{ p.link }}">{{ p.link }}</a></div><div class="log">{% if p.lines %}{% for ln in p.lines %}<div class="ln">{{ ln }}</div>{% endfor %}{% else %}<div class="ln muted">(empty)</div>{% endif %}</div>{% endif -%}
{%- endmacro -%}

{%- macro trace_panel(p) -%}
{%- if p.empty %}<div class="muted">app trace: <a href="{{ p.link }}">{{ p.link }}</a> (no intervals)</div>
{%- else %}<table><thead><tr><th>interval</th><th>duration</th><th>begin</th><th>end</th></tr></thead><tbody>{% for n, d, b, e in p.rows %}<tr><td>{{ n }}</td><td>{{ d }} ms</td><td>{{ b }}</td><td>{{ e }}</td></tr>{% endfor %}</tbody></table>{% endif -%}
{%- endmacro -%}

{%- macro env_panel(p) -%}
{%- if p.sim %}<div class="envsec"><span class="deflbl">simulator</span><table class="pretbl"><tbody>{% for k, v in p.sim %}<tr><td class="pk">{{ k }}</td><td>{{ v }}</td></tr>{% endfor %}</tbody></table></div>
{%- elif not p.skips %}<div class="muted">no environment details captured</div>{% endif -%}
{%- if p.skips %}<div class="envsec skipcap"><span class="deflbl">skipped evidence</span><table class="pretbl"><tbody>{% for s in p.skips %}<tr><td class="pk">{{ s.kind }}</td><td class="muted">{{ s.reason }}</td></tr>{% endfor %}</tbody></table></div>{% endif -%}
{%- endmacro -%}

{%- macro panel_body(panel) -%}
{%- if panel.kind == 'result' %}{{ result_panel(panel) }}
{%- elif panel.kind == 'env' %}{{ env_panel(panel) }}
{%- elif panel.kind == 'network' %}{{ network_panel(panel) }}
{%- elif panel.kind == 'log' %}{{ log_panel(panel) }}
{%- elif panel.kind == 'trace' %}{{ trace_panel(panel) }}{% endif -%}
{%- endmacro -%}

{%- macro scenario(s) -%}
<details class="scn" data-ok="{{ s.ok|lower }}"{% if s.open %} open{% endif %}><summary><span class="dot{% if not s.ok %} ng{% endif %}"></span><span class="smeta"><span class="sname">{{ s.name }}</span>{% if s.source_file %}<span class="scnfile" title="the scenario file this ran from">{{ s.source_file }}</span>{% endif %}{% if s.description %}<span class="sdesc">{{ s.description }}</span>{% endif %}</span> {% if s.backend %}<span class="drv" title="actuator backend">{{ s.backend }}</span>{% endif %}{% if s.device %}<span class="dev" title="ran on simulator {{ s.device }}">{{ s.device[-6:] }}</span>{% endif %}{% if s.duration %}<span class="sdur" title="scenario execution time">{{ s.duration }}</span>{% endif %}{% if s.ok %}<span class="pass">PASS</span>{% else %}<span class="fail">FAIL</span>{% endif %}</summary><div class="body"><div class="media">{% if s.video %}<div class="player"><video preload="metadata" src="{{ s.video }}"></video><div class="vctl"><button class="vplay" type="button" aria-label="play / pause">▶</button><span class="vseekwrap"><input class="vseek" type="range" min="0" max="0" value="0" step="0.05" aria-label="seek"><span class="vsegs" aria-hidden="true"></span><span class="vmarks" aria-hidden="true"></span><span class="vknobwrap" aria-hidden="true"><span class="vknob"></span></span></span><span class="vtime">0:00 / 0:00</span></div></div>{% else %}<div class="muted">no recording</div>{% endif %}</div><div class="detail"><div class="tabs">{% for panel in s.panels %}<button class="tab{% if loop.first %} active{% endif %}" data-tab="{{ panel.key }}">{{ panel.label }}</button>{% endfor %}</div>{% for panel in s.panels %}<div class="panel{% if loop.first %} active{% endif %}" data-panel="{{ panel.key }}">{{ panel_body(panel) }}</div>{% endfor %}</div></div></details>
{%- endmacro -%}
<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>Bajutsu run {{ run_id }}</title><style>{{ css|safe }}</style></head><body data-run-id='{{ run_id }}'><header><div class="htitle"><h1>Bajutsu run {{ run_id }} {% if overall %}<span class="pass">PASS</span>{% else %}<span class="fail">FAIL</span>{% endif %}</h1>{% if source_name %}<div class="subtitle"><span class="sfile">{{ source_name }}</span></div>{% endif %}{% if description %}<div class="fdesc">{{ description }}</div>{% endif %}</div><div class="stats"><span class="chip ok">{{ passed }} passed</span><span class="chip ng">{{ failed }} failed</span><span class="chip tchip" title="total execution time across all scenarios">{{ total_duration }}</span>{% if backend %}<span class="chip dchip" title="actuator backend">driver: {{ backend }}</span>{% endif %}{% if device_count > 1 %}<span class="chip dchip" title="scenarios split across {{ device_count }} simulators">{{ device_count }} devices</span>{% endif %}</div><div class="ctl"><label><input type="checkbox" onchange="onlyFailures(this)"> only failures</label><button class="hbtn" onclick="toggleAll(true)">expand all</button><button class="hbtn" onclick="toggleAll(false)">collapse all</button></div></header><main>{% if matrix %}<section class="matrix"><h2 class="mxh">cross-browser matrix</h2><table class="mxtbl"><thead><tr><th>scenario</th>{% for e in matrix.engines %}<th>{{ e }}</th>{% endfor %}</tr></thead><tbody>{% for row in matrix.rows %}<tr><td class="mxs">{{ row.scenario }}</td>{% for cell in row.cells %}<td class="mxc{% if cell is none %} mx-na{% elif cell.ok %} mx-ok{% else %} mx-ng{% endif %}"{% if cell and cell.failure %} title="{{ cell.failure }}"{% endif %}>{% if cell is none %}—{% elif cell.ok %}PASS{% else %}FAIL{% endif %}</td>{% endfor %}</tr>{% endfor %}</tbody></table></section>{% endif %}{% for s in scenarios %}{{ scenario(s) }}{% endfor %}</main><div class="tv" id="tv"><div class="tv-box"><button class="tv-close" type="button" aria-label="close">✕</button><div class="tv-step" hidden></div><div class="tv-filter"><input class="tvfilter" type="search" placeholder="filter elements…"><span class="tvcount muted"></span></div><div class="tv-body"></div></div></div><div class="imgz" id="imgz" hidden><img alt="screenshot"></div><script>{{ js|safe }}</script></body></html>
